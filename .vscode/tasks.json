{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "func: host start",
      "type": "shell",
      "command": "func host start --port 7207",
      "problemMatcher": {
        "owner": "azureFunctions",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Azure Functions Core Tools.*$",
          "endsPattern": "^.*Worker process started and initialized\\.?.*$"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/src/api/Vesta.Functions"
      },
      "dependsOn": "dotnet: build api",
      "isBackground": true
    },
    {
      "label": "dotnet: build api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/api/Vesta.Functions/Vesta.Functions.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
